# ===================================
# Netlify Functions - Email Config
# ===================================
# Copy this file as .env and fill in your credentials.
# NEVER commit .env to version control.

# Gmail address used to send emails (e.g. yourname@gmail.com)
GMAIL_USER=

# 16-character App Password generated from Google Account
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# (Optional) Recipient email – defaults to GMAIL_USER if not set
RECIPIENT_EMAIL=
