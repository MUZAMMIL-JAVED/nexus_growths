# ===================================
# Netlify Functions - Email Config
# ===================================
# Copy this file as .env and fill in your credentials.
# NEVER commit .env to version control.

# ── Hostinger Business Email (SMTP) ──────────────────────────────────
# Your full domain email address (the "From" address)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@nexusgrowths.com

# The App Password generated from Hostinger hPanel → Email → Manage → App Passwords
# (NOT your regular email login password)
SMTP_PASS=

# (Optional) Recipient email – defaults to SMTP_USER if not set
RECIPIENT_EMAIL=contact@nexusgrowths.com
